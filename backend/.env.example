# =====================================================================
# Configuração do Backend — Gestão de Pátio Sambaíba v3.0
# =====================================================================
# Copie este arquivo para `.env` e ajuste os valores para seu ambiente.
# NUNCA commite o `.env` real (ele está no .gitignore).
# =====================================================================

# --- Banco de dados ---
# Formato: postgresql+psycopg://USUARIO:SENHA@HOST:PORTA/BANCO
# Local (desenvolvimento):
DATABASE_URL=postgresql+psycopg://postgres:SUA_SENHA_AQUI@localhost:5432/gestao_patio_sambaiba

# --- Segurança ---
# Chave secreta para assinar os tokens JWT.
# Gere uma forte com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=mude-isto-em-producao-com-uma-string-aleatoria-longa-e-segura
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Ambiente ---
# development | staging | production
ENVIRONMENT=development

# --- CORS ---
# Origens permitidas separadas por vírgula. Em produção, restrinja!
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500,https://alisson84martins.github.io

# --- Logs ---
LOG_LEVEL=INFO

# --- Pré-ocorrência do motorista — webhook n8n ---
# Opcionais. Sem elas, a autorização grava normalmente e só a notificação
# por WhatsApp/SMS não dispara (loga e segue, nunca derruba a requisição).
# URL do fluxo n8n que recebe o POST quando uma autorização é aberta.
N8N_WEBHOOK_URL=
# Token enviado no header Authorization do POST acima, se o seu fluxo n8n exigir.
N8N_WEBHOOK_TOKEN=

# --- Pré-ocorrência do motorista — link enviado ao motorista ---
# Opcional — deixe comentada. URL base da página pública onde o
# motorista preenche o relato (?token=... é anexado automaticamente).
# Sem esta variável (comentada ou ausente), vale o default correto:
# https://www.gestaopatiosambaiba.com.br/pre-ocorrencia.html
# Descomente só se o domínio mudar. Uma linha presente e vazia
# (PRE_OCORRENCIA_LINK_BASE=) SUBSTITUI o default por string vazia — não
# é a mesma coisa que "ausente".
# PRE_OCORRENCIA_LINK_BASE=https://www.gestaopatiosambaiba.com.br/pre-ocorrencia.html

# --- Portaria — leitura de placa por câmera ---
# Interruptor do recurso (substitui o QR do Bloco E). Default false: sobe
# desligado, confere que nada quebrou, só depois liga. true/false — mudar
# e reiniciar o serviço, sem migration nem deploy de frontend.
LEITURA_PLACA_ATIVA=false
